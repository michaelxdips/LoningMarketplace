{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "engines": { "node": ">=20 <27" },
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:all": "concurrently -k -n frontend,backend \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:local": "npm run db:local:setup && npm run dev:all",
    "db:local:up": "docker compose up -d postgres",
    "db:local:down": "docker compose down",
    "db:local:logs": "docker compose logs -f postgres",
    "db:local:wait": "node scripts/wait-for-postgres.mjs",
    "db:local:setup": "npm run db:local:up && npm run db:local:wait && npm run db:migrate --workspace=backend && npm run db:seed --workspace=backend",
    "db:local:reset": "docker compose down -v",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:all": "npm run build",
    "clean": "rm -rf dist server.js frontend/dist",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "test:integration": "node scripts/test-integration-local.mjs",
    "test:integration:local": "node scripts/test-integration-local.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/run-e2e-local.mjs",
    "test:all": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "concurrently": "^10.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@playwright/test": "^1.52.0"
  }
}
