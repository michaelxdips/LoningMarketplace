DATABASE_URL=postgresql://loning:loning_local_dev@localhost:5432/loning_digital
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
SESSION_TTL_HOURS=168
SESSION_RETENTION_DAYS=30
SESSION_COOKIE_NAME=loning_session
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_MAX=100
# Set true on Vercel, Render, and Railway so cookies and client IP work behind a proxy.
TRUST_PROXY=false
COOKIE_SECURE=false
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_FILESYSTEM_ROOT=./storage
MEDIA_PUBLIC_BASE_URL=http://localhost:3001/media
MEDIA_MAX_BYTES=5242880
MEDIA_MAX_WIDTH=8000
MEDIA_MAX_HEIGHT=8000
MEDIA_MAX_PIXELS=40000000
MEDIA_ORPHAN_GRACE_HOURS=24
# Required when MEDIA_STORAGE_DRIVER=s3 (and filesystem is rejected in production).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Temporary values used only by npm run admin:create. Do not commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
