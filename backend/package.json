{
  "name": "loning-maju-backend",
  "private": true,
  "version": "1.0.0",
  "engines": { "node": ">=20 <27" },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "node -e \"console.error('db:seed is disabled; use db:seed:dev, db:seed:test, or db:seed:preview explicitly.'); process.exit(1)\"",
    "db:seed:dev": "tsx src/db/seed.ts --profile development",
    "db:seed:test": "tsx src/db/seed.ts --profile test",
    "db:seed:preview": "tsx src/db/seed.ts --profile preview",
    "db:reset-safe": "tsx src/scripts/db-reset.ts",
    "admin:create": "node -e \"console.error('admin:create is disabled; use db:bootstrap-admin explicitly.'); process.exit(1)\"",
    "db:bootstrap-admin": "tsx src/scripts/admin-create.ts",
    "sessions:cleanup": "tsx src/scripts/sessions-cleanup.ts",
    "media:cleanup": "tsx src/scripts/media-cleanup.ts",
    "analytics:retention": "tsx src/scripts/public-events-retention.ts",
    "analytics:retention:apply": "tsx src/scripts/public-events-retention.ts --apply",
    "e2e:setup": "tsx src/scripts/e2e-setup.ts",
    "db:audit": "tsx src/scripts/db-audit.ts",
    "db:seed-hash": "tsx src/scripts/seed-hash.ts",
    "storage:check": "tsx src/scripts/storage-check.ts",
    "media:audit": "tsx src/scripts/media-audit.ts",
    "media:recover-seed": "tsx src/scripts/seed-media-recovery.ts",
    "media:recover-seed:apply": "tsx src/scripts/seed-media-recovery.ts --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "argon2": "^0.45.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "postgres": "^3.4.7",
    "sharp": "^0.35.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}
