# ==============================================================================
# Loning Maju — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env for local development or set these variables in your
# deployment platform (Render, Railway, Fly.io, VPS, etc.).
# DO NOT include real passwords, keys, or secrets in this template.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Build-time & Runtime)
# ------------------------------------------------------------------------------
# VITE_PUBLIC_SITE_URL: REQUIRED for production builds (command: npm run build).
# Must be a valid absolute HTTPS URL without trailing slash, credentials, or query params.
VITE_PUBLIC_SITE_URL=https://loningmaju.desa.id

# VITE_API_URL: Optional if frontend & backend are served from the same origin (/api).
# Required if the API backend is on a separate origin (e.g. https://api.loningmaju.desa.id/api).
VITE_API_URL=http://localhost:3001/api

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Runtime)
# ------------------------------------------------------------------------------
# Runtime environment ('development', 'test', or 'production')
NODE_ENV=development

# Server binding & network configuration
PORT=3001
HOST=0.0.0.0
TRUST_PROXY=false

# PostgreSQL Database Connection URL (REQUIRED)
DATABASE_URL=postgresql://loning_dev:loning_dev_pass@127.0.0.1:5432/loning_maju_dev

# Cross-Origin Resource Sharing (CORS) — REQUIRED in production.
# Must be one explicit origin (e.g. https://loningmaju.desa.id). Wildcards or lists are rejected.
CORS_ORIGIN=http://localhost:3000

# Cookie Security (Defaults to true when NODE_ENV=production)
COOKIE_SECURE=false

# Media Storage Configuration
# Local development: 'filesystem'
# Production: MUST be 's3'
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_FILESYSTEM_ROOT=./storage
MEDIA_PUBLIC_BASE_URL=http://localhost:3001

# S3 Storage Configuration (REQUIRED when MEDIA_STORAGE_DRIVER=s3)
# S3_BUCKET=loning-maju-media
# S3_REGION=ap-southeast-1
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# S3_ACCESS_KEY_ID=your-s3-access-key-id
# S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# S3_FORCE_PATH_STYLE=false
